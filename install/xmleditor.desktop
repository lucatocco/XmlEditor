[Desktop Entry]
Version=1.0
Type=Application
Name=XML Editor
GenericName=XML Editor
Comment=XML file editor with syntax highlighting and XSD validation
Exec=/usr/local/bin/xmleditor %F
Icon=xmleditor
Terminal=false
StartupNotify=true
Categories=Utility;TextEditor;Development;
MimeType=text/xml;application/xml;text/plain;application/xsd+xml;
Keywords=xml;xsd;editor;text;
StartupWMClass=XmlEditor
